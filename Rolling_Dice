# Dice Rolling Program

import random 

dice_faces = {1: "⚀", 2: "⚁", 3: "⚂", 4: "⚃",5: "⚄", 6: "⚅"}

print("=== Welcome to the Dice Roller! ===")

total_dice_rolled = 0 

while True:

    answer = input("\nHow many dice do you want to roll? ")

    if int(answer) < 1:
        print("❌ Error: Please enter a whole number.")
        continue 

    number_of_dice = int(answer)

    print("\nRolling...")

    for die_number in range(1, number_of_dice + 1):
        result = random.randint(1, 6) 
        print("Die", die_number, ":", dice_faces[result], "(", result, ")")

    total_dice_rolled = total_dice_rolled + number_of_dice
    print("\n📊 Total dice rolled so far:", total_dice_rolled)

    again = input("\nDo you want to roll again? (yes/no): ").lower().strip()

    if again != "yes":
        print("\n👋 Thanks for playing! You rolled", total_dice_rolled, "dice in total.")
        break